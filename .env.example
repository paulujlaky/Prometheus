# Prometheus (pts) settings.

# --- Server ---

# Where pts listens. Keep 127.0.0.1 behind a TLS proxy; 0.0.0.0 exposes it without TLS.
PTS_HOST=127.0.0.1
PTS_PORT=7420

# Database, agents' workspaces and browser profiles. It holds every user's Boodle cookie, so it is private to this user.
PTS_HOME=/home/you/.pts

# Contact for web push, which Apple requires: a mailto: or https: address you own.
PTS_VAPID_SUBJECT=mailto:you@example.com

# --- Browsing ---

# One HTTP proxy for every agent's browser. With it set, browsers also cannot reach services on this machine.
PTS_PROXY=http://username:pass@ip:port

# --- Limits ---

# Agents working at once, across all users.
PTS_MAX_RUNNING=5

# Each shell command an agent runs: memory, CPU (100% is one core), processes, and time in ms.
PTS_MEMORY_MAX=1G
PTS_CPU_QUOTA=100%
PTS_TASKS_MAX=512
PTS_CMD_TIMEOUT_MS=600000

# Steps one task may take, and how long an agent waits on a question or approval (ms) before giving up.
PTS_MAX_STEPS=60
PTS_ANSWER_MS=1800000

# Agent-to-agent hand-offs in a row in a group chat.
PTS_MAX_HOPS=6

# An idle agent's browser closes after this many ms.
PTS_BROWSER_IDLE_MS=600000
